{
  "name": "fimg-agent-plugin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "figma-agent": "./bin/figma-agent.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "bridge/",
    "plugin/",
    "tools/",
    "server/",
    "specs/validate-spec.mjs",
    "docs/PRD-WORKFLOW.md",
    "docs/PROTOTYPE-WORKFLOW.md",
    "docs/VISUAL-DESIGN-WORKFLOW.md",
    "docs/DEV-HANDOFF-WORKFLOW.md",
    "docs/QA-VERIFY-WORKFLOW.md",
    "docs/DESIGN-AGENT.md",
    "docs/TEAM-INTAKE.md",
    "AGENTS.md"
  ],
  "description": "纯 Node 多角色业务设计 Agent（Figma 本地桥 + MCP + PRD 双端生成 + 视觉对图 + 内网自举分发）",
  "keywords": [
    "figma",
    "plugin",
    "prototype",
    "agent",
    "design-automation"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "bridge": "./scripts/start-bridge.sh",
    "doctor": "node bin/figma-agent.mjs doctor",
    "setup": "node bin/figma-agent.mjs setup",
    "mcp": "node bin/figma-agent.mjs mcp",
    "serve-dist": "node bin/figma-agent.mjs serve-dist",
    "test": "node --test test/design-contract.test.mjs test/prd-workflow.test.mjs test/distribution.test.mjs test/all-roles.test.mjs",
    "test:plugin": "node test/plugin.test.mjs",
    "check": "node specs/validate-spec.mjs",
    "status": "node tools/figma.mjs status",
    "ping": "node tools/figma.mjs ping",
    "stats": "node tools/figma.mjs stats",
    "list": "node tools/figma.mjs list",
    "sel": "node tools/figma.mjs sel",
    "dump": "node tools/figma.mjs dump",
    "patch": "node tools/figma.mjs patch",
    "insert": "node tools/figma.mjs insert",
    "rm": "node tools/figma.mjs rm",
    "render": "node tools/figma.mjs render",
    "export": "node tools/figma.mjs export --all",
    "clear": "node tools/figma.mjs clear",
    "fake-plugin": "node test/fake-plugin.mjs"
  },
  "dependencies": {},
  "devDependencies": {}
}
