#!/usr/bin/env bash
# =============================================================================
# fimg —— 统一入口（不依赖 npm）
#
#   ./fimg doctor              一键自检（推荐第一次先跑这个）
#   ./fimg test                插件单元测试（不需要 Figma）
#   ./fimg bridge              启动本地桥（常驻）
#
#   ./fimg status | ping | stats | list | sel
#   ./fimg dump  --name "卡片" --out dumps/c.json
#   ./fimg patch --ops ops.json --dry
#   ./fimg insert --parent 12:345
#   ./fimg rm    --name "旧卡片" --dry
#   ./fimg render | export | clear
#
#   ./fimg prd | proto | visual | dev-handoff | qa | visual-diff
#   ./fimg setup | mcp | serve-dist | check | fake-plugin
#
# 为什么不用 npm：本环境里 npm 可能不存在（node 是内置运行时）。
# 这个入口自己解析运行时，所以任何机器上都能用。
# =============================================================================
set -uo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if ! . "$DIR/scripts/runtime.sh"; then
  exit 1
fi
cd "$REPO_ROOT"

CMD="${1:-help}"
[ $# -gt 0 ] && shift

case "$CMD" in
  # —— 项目自带工具
  doctor)          exec "$NODE" bin/biz-design-agent.mjs doctor "$@" ;;
  setup)           exec "$NODE" bin/biz-design-agent.mjs setup "$@" ;;
  mcp)             exec "$NODE" bin/biz-design-agent.mjs mcp "$@" ;;
  prd)             exec "$NODE" bin/biz-design-agent.mjs prd "$@" ;;
  proto)           exec "$NODE" bin/biz-design-agent.mjs proto "$@" ;;
  visual)          exec "$NODE" bin/biz-design-agent.mjs visual "$@" ;;
  dev-handoff)     exec "$NODE" bin/biz-design-agent.mjs dev "$@" ;;
  qa)              exec "$NODE" bin/biz-design-agent.mjs qa "$@" ;;
  visual-diff)     exec "$NODE" bin/biz-design-agent.mjs visual-diff "$@" ;;
  serve-dist)      exec "$NODE" bin/biz-design-agent.mjs serve-dist "$@" ;;
  bridge-ensure)   exec "$NODE" bin/biz-design-agent.mjs bridge-ensure "$@" ;;
  test)            exec "$NODE" test/plugin.test.mjs ;;
  bridge|start)    exec ./scripts/start-bridge.sh ;;
  check|validate)  exec "$NODE" specs/validate-spec.mjs "$@" ;;
  fake-plugin)     exec "$NODE" test/fake-plugin.mjs "$@" ;;

  # —— 其余全部转给 CLI（status/ping/stats/list/sel/dump/patch/insert/rm/render/export/clear）
  help|-h|--help|"")
                   exec "$NODE" bin/biz-design-agent.mjs help ;;
  *)               exec "$NODE" tools/figma.mjs "$CMD" "$@" ;;
esac
